# Copy to .env and fill in. .env is gitignored.

# OpenRouter — the single provider for every LLM call site. The model pool and
# rotation policy live in llm/models.py (MODEL_POOL, COOLDOWN_SECONDS).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Cache-only, zero network. Set to 1 for the live demo after a real run has
# populated the cache. Any cache miss becomes a fatal, named error.
REPLAY_MODE=0
